# =============================================================================
# HARVESTROUTE - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# Official Government of India Data.gov.in API Key
# Sign up and generate a free API key at https://data.gov.in
VITE_DATA_GOV_IN_API_KEY=

# Open Source Routing Machine (OSRM) Public / Self-Hosted Endpoint
# Default: https://router.project-osrm.org/route/v1/driving
VITE_OSRM_ROUTING_URL=https://router.project-osrm.org/route/v1/driving

# Hackathon Demo Mode
# When set to 'false' (production default), live data feeds are prioritized.
# When set to 'true', regional benchmarks are preloaded for offline presentations.
VITE_ENABLE_DEMO_MODE=false

# Python ML Microservice URL (FastAPI)
# Default: http://127.0.0.1:8000
HARVESTROUTE_ML_SERVICE_URL=http://127.0.0.1:8000

# Administrative Authorization Key for Protected Retraining Endpoint (POST /api/ml/train)
HARVESTROUTE_ADMIN_API_KEY=

# Open-Meteo Weather API Configuration
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# =============================================================================
# Backend-Only Search & Intelligence API Keys (NEVER expose to frontend via VITE_)
# =============================================================================

# Tavily Search API Key (Used by backend search service to find live mandi rates)
TAVILY_API_KEY=

# Search Provider ('tavily' | 'brave' | 'serper')
SEARCH_PROVIDER=tavily

# Gemini API Key (Backend-only, for advanced agricultural text extraction/analysis)
GEMINI_API_KEY=
